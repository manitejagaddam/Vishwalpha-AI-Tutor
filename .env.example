# VishwAlpha AI Tutor — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://viswalpha-foundry-50bd.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=viswalpha-gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=viswalpha-text-embedding-3-small

# ── Redis Cache (Upstash or self-hosted) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Token expiry in minutes (default: 7 days = 10080)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://vishwalpha.app,https://www.vishwalpha.app

# ── Admin ─────────────────────────────────────────────────────────────────────
# Used for protected admin endpoints (PDF ingestion, etc.)
# Generate with: openssl rand -hex 24
ADMIN_API_KEY=your-admin-api-key-here

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_READ=120/minute
RATE_LIMIT_AUTH=10/minute
