# Database Settings (PostgreSQL via Supabase or other cloud provider)
DATABASE_URL=
# Redis Settings (Upstash or other cloud provider)
REDIS_URL=
# Groq Settings
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

HF_TOKEN=

# Phase 3 — Topic Mastery Decay (controls apply_mastery_decay)
MASTERY_DECAY_DAYS=30       # days without revisit before decay triggers
MASTERY_DECAY_RATE=0.05     # 5% reduction per decay interval

# Phase 5 — Cache TTLs (seconds)
CACHE_EMB_TTL=604800        # 7 days for embedding cache
CACHE_CHUNK_TTL=2592000     # 30 days for retrieval cache (static curriculum)
CACHE_PREREQ_TTL=2592000    # 30 days for prerequisite cache
